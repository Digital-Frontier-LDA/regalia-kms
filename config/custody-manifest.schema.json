{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regalia.invalid/schemas/custody-manifest-v1.json",
  "title": "Regalia custody manifest",
  "description": "Non-secret metadata that binds every company cryptographic object to custody, policy, hardware and recovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "generated_at",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/custodyObject"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "backend",
        "device_id",
        "object_id",
        "state"
      ],
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "enum": [
            "nitrokey-pkcs11",
            "yubikey-piv",
            "yubikey-openpgp",
            "fido2"
          ]
        },
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "device_serial": {
          "type": "string",
          "minLength": 1
        },
        "devaut_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "public_key_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "kek_algorithm": {
          "enum": [
            "rsa2048",
            "rsa3072",
            "rsa4096"
          ]
        },
        "kek_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
        },
        "public_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "key_check": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "planned",
            "qualified",
            "active",
            "standby",
            "retired",
            "revoked"
          ]
        },
        "pin_policy": {
          "enum": [
            "once",
            "always"
          ]
        },
        "touch_policy": {
          "const": "never"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "public_fingerprint"
              ]
            },
            {
              "required": [
                "key_check"
              ]
            }
          ]
        },
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "yubikey-piv",
                  "yubikey-openpgp"
                ]
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "pin_policy",
              "touch_policy"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "pin_policy"
                  ]
                },
                {
                  "required": [
                    "touch_policy"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "nitrokey-pkcs11"
              },
              "state": {
                "enum": [
                  "qualified",
                  "active",
                  "standby"
                ]
              }
            },
            "required": [
              "backend",
              "state"
            ]
          },
          "then": {
            "required": [
              "device_serial"
            ],
            "anyOf": [
              {
                "required": [
                  "devaut_fingerprint"
                ]
              },
              {
                "required": [
                  "public_key_sha256"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "yubikey-piv",
                  "yubikey-openpgp"
                ]
              },
              "state": {
                "enum": [
                  "qualified",
                  "active",
                  "standby"
                ]
              }
            },
            "required": [
              "backend",
              "state"
            ]
          },
          "then": {
            "required": [
              "device_serial"
            ]
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status"
      ],
      "properties": {
        "mode": {
          "enum": [
            "shamir-4-of-6",
            "multi-enrollment",
            "rebuild-public",
            "exception"
          ]
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "minimum_replicas": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "planned",
            "tested",
            "accepted",
            "overdue"
          ]
        },
        "last_drill": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "shamir-4-of-6"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "authority_id",
              "minimum_replicas"
            ],
            "properties": {
              "minimum_replicas": {
                "const": 2
              }
            }
          }
        }
      ]
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_age_days",
        "last_rotated"
      ],
      "properties": {
        "maximum_age_days": {
          "type": "integer",
          "minimum": 1
        },
        "last_rotated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "envelope_max_age_days": {
          "type": "integer",
          "minimum": 1,
          "description": "How old an envelope of this object may be at release, in days. Absent means unbounded. Distinct from maximum_age_days, which bounds the KEY's age from last_rotated; this bounds each envelope from its own created_at."
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "in-progress",
            "migrated",
            "exception",
            "not-applicable"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "owner_repository": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "expires",
        "approved_by"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expires": {
          "type": "string",
          "format": "date"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "last_verified",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "verified",
            "failed",
            "overdue"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "custodyObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "classification",
        "environment",
        "owner",
        "purpose",
        "custody",
        "algorithm",
        "operations",
        "policy_id",
        "bindings",
        "recovery",
        "rotation",
        "migration",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "asymmetric-key",
            "symmetric-key",
            "opaque-secret",
            "password",
            "api-token",
            "seed",
            "certificate",
            "fido-credential",
            "sops-recipient"
          ]
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "critical"
          ]
        },
        "environment": {
          "enum": [
            "production",
            "staging",
            "development"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "custody": {
          "enum": [
            "direct-hardware",
            "hardware-envelope",
            "fido-multi-enrollment",
            "exception"
          ]
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "migration": {
          "$ref": "#/$defs/migration"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "exception": {
          "$ref": "#/$defs/exception"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "environment": {
                "const": "production"
              },
              "custody": {
                "not": {
                  "const": "exception"
                }
              }
            },
            "required": [
              "environment",
              "custody"
            ]
          },
          "then": {
            "properties": {
              "bindings": {
                "minItems": 2
              }
            }
          }
        },
        {
          "comment": "An opaque secret has no algorithm of its own, so release-secret bindings must name the wrapping key in the slot; elsewhere the object's algorithm already names it and a second answer could disagree. This schema deliberately does NOT check that the backend admits the operation at all, or that it can unwrap with the named kek_algorithm: both need the backend capability table, and restating it here would recreate the duplication #73 removed after the Go and Python copies drifted. registry.validateBinding and tools/custody_manifest.py both read the exported config/backend-capabilities.json and enforce it, so a manifest valid to this schema alone may still be refused by the loader and by CI.",
          "if": {
            "properties": {
              "operations": {
                "contains": {
                  "const": "release-secret"
                }
              }
            },
            "required": [
              "operations"
            ]
          },
          "then": {
            "properties": {
              "bindings": {
                "items": {
                  "required": [
                    "kek_algorithm",
                    "kek_version"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "bindings": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "kek_algorithm"
                        ]
                      },
                      {
                        "required": [
                          "kek_version"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody": {
                "const": "exception"
              }
            },
            "required": [
              "custody"
            ]
          },
          "then": {
            "required": [
              "exception"
            ]
          },
          "else": {
            "not": {
              "required": [
                "exception"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody": {
                "const": "fido-multi-enrollment"
              }
            },
            "required": [
              "custody"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "fido-credential"
              },
              "bindings": {
                "minItems": 2,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/binding"
                    },
                    {
                      "properties": {
                        "backend": {
                          "const": "fido2"
                        }
                      }
                    }
                  ]
                }
              },
              "recovery": {
                "allOf": [
                  {
                    "$ref": "#/$defs/recovery"
                  },
                  {
                    "properties": {
                      "mode": {
                        "const": "multi-enrollment"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody": {
                "enum": [
                  "direct-hardware",
                  "hardware-envelope"
                ]
              }
            },
            "required": [
              "custody"
            ]
          },
          "then": {
            "properties": {
              "recovery": {
                "allOf": [
                  {
                    "$ref": "#/$defs/recovery"
                  },
                  {
                    "properties": {
                      "mode": {
                        "enum": [
                          "shamir-4-of-6",
                          "multi-enrollment"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody": {
                "const": "hardware-envelope"
              }
            },
            "required": [
              "custody"
            ]
          },
          "then": {
            "properties": {
              "recovery": {
                "properties": {
                  "mode": {
                    "const": "shamir-4-of-6"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
