    {
      "id": "KMS-CI-010",
      "capability": "delivery/software-build-and-ci",
      "title": "Enforce the finite OpenSpec checks in build-test",
      "status": "UNVERIFIED",
      "sources": [
        {
          "path": ".github/workflows/ci.yml",
          "line": 260,
          "symbol": "build-test.openspec-checks",
          "supports": "Makes required command and piped reference failures fail the check step.",
          "fileSha256": "da78b11f47a36ff5ac00319933ac7a292600c5b22c77c59e82b373b84b5894e1",
          "text": "          set -euo pipefail",
          "lineSha256": "b59ebfa511328c02df3dede32efbef4258b32fd3b735083046107f6e9ba82602"
        },
        {
          "path": ".github/workflows/ci.yml",
          "line": 270,
          "symbol": "build-test.openspec-checks",
          "supports": "Runs strict validation on main specs and active changes.",
          "fileSha256": "da78b11f47a36ff5ac00319933ac7a292600c5b22c77c59e82b373b84b5894e1",
          "text": "          \"$node\" \"$cli\" validate --all --strict --no-interactive --json",
          "lineSha256": "8fefef72563570a9e16cbe4bb5f1ae6d1deabfe1e79b11be12c37d59218cf32d"
        },
        {
          "path": ".github/workflows/ci.yml",
          "line": 271,
          "symbol": "build-test.openspec-checks",
