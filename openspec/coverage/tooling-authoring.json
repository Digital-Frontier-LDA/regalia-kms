          "text": "          python3 -BEs -m unittest discover -v -s tests -p test_check_openspec_references.py",
          "lineSha256": "a726d36b209ee0d13c5b9787c362723a6505c1dcd0ff09efa2168deba1fe9395"
        },
        {
          "path": ".github/workflows/ci.yml",
          "line": 289,
          "symbol": "build-test.openspec-checks",
          "supports": "Runs the reference checker with the pinned product input and retains its JSON.",
          "fileSha256": "da78b11f47a36ff5ac00319933ac7a292600c5b22c77c59e82b373b84b5894e1",
          "text": "            --source-revision \"$OPENSPEC_PRODUCT_REVISION\" \"${tooling_args[@]}\" | tee \"$runtime/references.json\"",
          "lineSha256": "ca4f96da98b1ef0a221ea17336f7ca40e351e6a3cfc9ca24d196d6e3691224a4"
        },
        {
          "path": "tools/openspec-ci/check-source.sh",
          "line": 45,
          "symbol": "verify and verify-tooling",
          "supports": "Requires the declared commit object to be locally available before use.",
          "fileSha256": "f8b77cbedda54fd7255aa436e22c1b8829dc3b4e060f214b2ef10af46a1a3e5c",
          "text": "        kind=\"$(local_git -C \"$source_path\" cat-file -t \"$revision\")\" || fail \"required ${domain} object is not a locally available commit\"",
          "lineSha256": "785051daee7ff32af2c1211e88293d7e2a1ef6bca309a9574afa003a74f3c47d"
        }
      ],
      "tests": [
        {
          "path": "tools/openspec-ci/wiring.test.cjs",
          "line": 43,
          "symbol": "required tail uses the immutable product checkout and preserves aggregate participation",
          "supports": "Asserts the aggregate still depends on build-test.",
          "fileSha256": "26c561170b4ac733b87ebea2a99f8b4ac8016cf11601fd5f10f48e3973bec895",
          "text": "    assert.ok(workflow.jobs['ci-gate'].needs.includes('build-test'));",
          "lineSha256": "2037ad447188d8e78caed941c605ef5bebe37aa57d9a129e1465a76da49fbc30"
        },
        {
          "path": "tools/openspec-ci/wiring.test.cjs",
          "line": 62,
          "symbol": "required tail uses the immutable product checkout and preserves aggregate participation",
          "supports": "Asserts the actual workflow pin and product tree check.",
          "fileSha256": "26c561170b4ac733b87ebea2a99f8b4ac8016cf11601fd5f10f48e3973bec895",
          "text": "    assert.equal(actual[2].run, 'bash tools/openspec-ci/check-source.sh verify ' + revision + ' ' + tree);",
          "lineSha256": "593173958fa970e094a07e593a785a16192b922c46e4ddffc444996f9e5b354a"
        },
        {
          "path": "tools/openspec-ci/wiring.test.cjs",
          "line": 158,
          "symbol": "actual check step runs strict validation, focused tests and the reference envelope in order",
          "supports": "Checks the actual extracted shell-body phase sequence with command doubles.",
          "fileSha256": "26c561170b4ac733b87ebea2a99f8b4ac8016cf11601fd5f10f48e3973bec895",
          "text": "    assert.deepEqual(trace, phases, 'missing or reordered required check');",
          "lineSha256": "3672df4c17a02bf17d5aa1ff90e77b51bc6bb9c5de3c90f9d96f329bccd4ab61"
        },
        {
          "path": "tools/openspec-ci/wiring.test.cjs",
          "line": 165,
          "symbol": "actual check step fails closed when a phase fails",
          "supports": "Checks subsequent phases stop after an injected strict, test, or reference failure.",
          "fileSha256": "26c561170b4ac733b87ebea2a99f8b4ac8016cf11601fd5f10f48e3973bec895",
          "text": "        assert.deepEqual(trace, phases.slice(0, phases.indexOf(phase) + 1));",
          "lineSha256": "9aadc29151eb163a0ff08715b245792cda3928b9a89b40cc7b3c2dacea2d8ee4"
        }
      ],
      "rationale": "Workflow declarations and shell-body assertions describe required local behavior. The earlier executed hosted tail remains recorded only at its own revision.",
      "executionEvidence": [],
      "beads": []
    },
