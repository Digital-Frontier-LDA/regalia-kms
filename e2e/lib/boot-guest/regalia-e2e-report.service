[Unit]
Description=regalia e2e: report that the root filesystem is up, and power off
# Read PCR 11 only after systemd has extended the ready phase. Otherwise the
# report can race that extension and power off before the system value exists.
Requires=systemd-pcrphase.service
After=regalia-e2e-enrol.service systemd-pcrphase.service

[Service]
Type=oneshot
ExecStart=/usr/lib/regalia/e2e-report

[Install]
WantedBy=multi-user.target
