[Unit]
Description=regalia e2e: the settled system state after every multi-user job has ended
# Started by e2e-report via systemd-run --on-active=5s (regalia-kms-r1s.17, AC1): the report is a oneshot of
# multi-user.target, so its own is-system-running would read "starting". The probe is started AFTER the report
# finishes, outside the boot transaction, where is-system-running settles to "running" on a healthy host.
# No [Install] section: it is not WantedBy any target, only started by the report's systemd-run.

[Service]
Type=oneshot
ExecStart=/usr/lib/regalia/e2e-probe
