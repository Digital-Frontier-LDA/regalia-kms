#!/bin/sh
# Inside the test guest, once the root filesystem is up: say so on the console, with what is left of
# the boot mesh (nothing should be), and power off.
mesh=absent; ip link show wg-boot >/dev/null 2>&1 && mesh=present
table=absent; nft list table inet regalia_boot >/dev/null 2>&1 && table=present
addresses="$(ip -o addr show scope global | wc -l)"       # IPv4 and IPv6
link=down; ip -o link show eth0 | grep -q "state UP" && link=up
mapped=no; [ -e /dev/mapper/root ] && mapped=yes
echo "REGALIA-E2E-ROOT-UP root=$mapped wg-boot=$mesh table=$table addresses=$addresses link=$link" > /dev/console
# THE VERITY /usr (#61 K61V-4), a proof on every boot: what /usr, / and /var are, and dm-verity's own word on /usr (its
# status, verified or corrupted, and the root hash the kernel holds). "root" is the LUKS mapping the initrd's crypttab
# names; it is /var now (the UKI's systemd.mount-extra=)
src(){ findmnt -no SOURCE "$1" 2>/dev/null | head -1; }
fstype(){ findmnt -no FSTYPE "$1" 2>/dev/null | head -1; }
verity="$(veritysetup status usr 2>&1)"
vstatus="$(printf '%s\n' "$verity" | sed -n 's/^[[:space:]]*status:[[:space:]]*//p' | head -1)"
vhash="$(printf '%s\n' "$verity" | sed -n 's/^[[:space:]]*root hash:[[:space:]]*//p' | head -1)"
echo "REGALIA-E2E-VERITY usr=$(src /usr):$(fstype /usr) root=$(src /):$(fstype /) var=$(src /var):$(fstype /var) status=${vstatus:-none} roothash=${vhash:-none}" > /dev/console
# which firmware entry booted: BootCurrent, and that entry as efibootmgr reads it (label, then its device path)
current="$(efibootmgr 2>/dev/null | sed -n 's/^BootCurrent: //p')"
entry="$(efibootmgr -v 2>/dev/null | grep "^Boot${current:-none}" | tr -s ' \t' ' ' | cut -c1-300)"
echo "REGALIA-E2E-BOOTENTRY current=${current:-none} entry=${entry:-none}" > /dev/console
# the machine ID PID 1 started with (from /var/lib/dbus/machine-id, kept on /var: etc-inventory.txt [boot]), whether
# this boot counts as a first boot, and what is enabled under /etc (nothing: the image's enablement is under /usr, and
# the preset pass a first boot runs enables nothing, units-enabled.txt)
firstboot=no; [ -e /run/systemd/first-boot ] && firstboot=yes
links="$(find /etc/systemd/system -type l 2>/dev/null | wc -l)"
echo "REGALIA-E2E-MACHINE id=$(cat /etc/machine-id 2>/dev/null || echo none) kept=$(cat /var/lib/dbus/machine-id 2>/dev/null || echo none) first-boot=$firstboot etc-links=$links" > /dev/console
# the units the image's /etc and its KMS depend on: whether each ran, and how it ended. ExecMainStartTimestampMonotonic
# is 0 for a service whose main process never started (a failed dependency, a failed assert)
for u in systemd-firstboot.service regalia-etc-factory.service systemd-sysusers.service apparmor.service chrony.service prometheus-node-exporter.service pcscd.socket regalia-kms.service; do
  st="$(systemctl show -P LoadState "$u" 2>/dev/null)/$(systemctl show -P ActiveState "$u" 2>/dev/null)/$(systemctl show -P Result "$u" 2>/dev/null)"
  started="$(systemctl show -P ExecMainStartTimestampMonotonic "$u" 2>/dev/null)"
  enabled="$(systemctl is-enabled "$u" 2>/dev/null | head -1)"
  echo "REGALIA-E2E-UNIT $u state=$st started=${started:-none} enabled=${enabled:-none}" > /dev/console
done
# /var was mounted IN THE INITRD (the UKI's systemd.mount-extra=...:x-initrd.mount): the initrd's own journal line for
# /sysroot/var, kept across switch-root, and the boot's first line naming the real root's var.mount, if any
initrdvar="$(journalctl -b -o cat --no-pager 2>/dev/null | grep -m1 -o 'Mounted sysroot-var.mount.*' | tr -s ' ' | cut -c1-120)"
echo "REGALIA-E2E-VARMOUNT initrd=${initrdvar:-none}" > /dev/console
# whether the factory copy's assert held (AssertPathIsDirectory=/usr/share/factory/etc): "no" on a broken image
echo "REGALIA-E2E-FACTORY assert=$(systemctl show -P AssertResult regalia-etc-factory.service 2>/dev/null || echo none)" > /dev/console
# AppArmor: is the daemon's profile loaded, and in which mode (the kernel's own list)
profile="$(grep -E '^regalia-kms \(' /sys/kernel/security/apparmor/profiles 2>/dev/null | head -1)"
# ... and chronyd's, by the process: the profile its running chronyd is confined by (attr/current), so "enforce" is
# AppArmor's own word on the daemon that reads its configuration through /etc's link to /var
chronyd=""
for comm in /proc/[0-9]*/comm; do
  read -r name < "$comm" 2>/dev/null || continue
  if [ "$name" = chronyd ]; then
    p="${comm%/comm}"; chronyd="$(cat "$p/attr/apparmor/current" 2>/dev/null || cat "$p/attr/current" 2>/dev/null)"; break
  fi
done
echo "REGALIA-E2E-CHRONYD confined=${chronyd:-none}" > /dev/console
echo "REGALIA-E2E-APPARMOR enabled=$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null || echo absent) regalia-kms=${profile:-none} etc-passwd=$(test -s /etc/passwd && echo present || echo absent)" > /dev/console
# What is left, on the running host, of what opened the root volume. MEASURED: nothing that names the
# key file. The unit the initrd generated is not loaded after switch-root (LoadState=not-found) and
# /run/systemd/generator holds the real root's units only. A probe on the running host cannot read
# the initrd's crypttab entry from systemd; it has to read the initrd image.
echo "REGALIA-E2E-ATTACH unit: $(systemctl show 'systemd-cryptsetup@root.service' -p LoadState,ActiveState,FragmentPath,ExecStart 2>&1 | tr -s ' \n' ' ' | cut -c1-400)" > /dev/console
echo "REGALIA-E2E-ATTACH generator: $(ls /run/systemd/generator /run/systemd/generator.late 2>&1 | tr -s ' \n' ' ' | cut -c1-300)" > /dev/console
echo "REGALIA-E2E-ATTACH dm: $(dmsetup table root 2>&1 | cut -d' ' -f1-4) crypttab-in-root: $(test -e /etc/crypttab && echo present || echo absent)" > /dev/console
echo "REGALIA-E2E-CMDLINE $(cat /proc/cmdline)" > /dev/console
# the PCRs once booted: PCR 11 is the image's booted-phase value; PCR 12 should be what the stub left. Read only
# once systemd-pcrphase.service has measured `ready` (#310: a read before it is the sysinit value, one phase
# short). The unit orders it; this says what it saw, so a regression fails by name, not as a PCR mismatch.
# One property per call: `show -p A,B --value` prints in systemd's own order (Result before ActiveState), not the
# order asked (regalia-kms-d9, measured on Debian 13's systemd 257)
phase="$(systemctl show -P ActiveState systemd-pcrphase.service 2>&1) $(systemctl show -P Result systemd-pcrphase.service 2>&1)"
echo "REGALIA-E2E-PCRPHASE systemd-pcrphase.service=$phase" > /dev/console
echo "REGALIA-E2E-PCRS 7=$(cat /sys/class/tpm/tpm0/pcr-sha256/7 2>&1) 11=$(cat /sys/class/tpm/tpm0/pcr-sha256/11 2>&1) 12=$(cat /sys/class/tpm/tpm0/pcr-sha256/12 2>&1)" > /dev/console
# what the unlock client left for the running system, after switch-root (public values)
echo "REGALIA-E2E-SESSION dir=$(stat -c '%U:%G:%a' /run/regalia 2>&1) id=$(cat /run/regalia/boot-session 2>&1) through=$(cat /run/regalia/key-given-through 2>&1 | tr -s ' \n' ' ')" > /dev/console
# whether systemd in the initrd imported credentials (the image's command line says it must not); its own
# message, kept in the journal across switch-root
imported=yes; journalctl -b -o cat --no-pager 2>/dev/null | grep -q "systemd.import_credentials=no is set, skipping importing of credentials" && imported=no
echo "REGALIA-E2E-IMPORT credentials-imported=$imported" > /dev/console
# and the client itself is gone: it held the local half and the boot session's private key
clients=0
for comm in /proc/[0-9]*/comm; do
    read -r name < "$comm" 2>/dev/null || continue
    [ "$name" = regalia-unlock ] && clients=$((clients + 1))
done
echo "REGALIA-E2E-CLIENT processes=$clients" > /dev/console
# whether the kernel really zeroes pages it frees and hands out (#221): the words are on the command line,
# but a kernel built without the options, or with a debug option that excludes them, ignores them. The
# kernel says what it enabled at boot (an info message, kept in the ring buffer whatever the loglevel).
echo "REGALIA-E2E-MEMINIT $(dmesg 2>/dev/null | grep -o 'mem auto-init:.*' | head -1)" > /dev/console
systemctl --no-block poweroff
