#!/bin/sh
# Inside the test guest, once the root filesystem is up: say so on the console, with what is left of
# the boot mesh (nothing should be), and power off.
mesh=absent; ip link show wg-boot >/dev/null 2>&1 && mesh=present
table=absent; nft list table inet regalia_boot >/dev/null 2>&1 && table=present
addresses="$(ip -o addr show scope global | wc -l)"       # IPv4 and IPv6
link=down; ip -o link show eth0 | grep -q "state UP" && link=up
mapped=no; [ -e /dev/mapper/root ] && mapped=yes
echo "REGALIA-E2E-ROOT-UP root=$mapped wg-boot=$mesh table=$table addresses=$addresses link=$link" > /dev/console
# What is left, on the running host, of what opened the root volume. MEASURED: nothing that names the
# key file. The unit the initrd generated is not loaded after switch-root (LoadState=not-found) and
# /run/systemd/generator holds the real root's units only. A probe on the running host cannot read
# the initrd's crypttab entry from systemd; it has to read the initrd image.
echo "REGALIA-E2E-ATTACH unit: $(systemctl show 'systemd-cryptsetup@root.service' -p LoadState,ActiveState,FragmentPath,ExecStart 2>&1 | tr -s ' \n' ' ' | cut -c1-400)" > /dev/console
echo "REGALIA-E2E-ATTACH generator: $(ls /run/systemd/generator /run/systemd/generator.late 2>&1 | tr -s ' \n' ' ' | cut -c1-300)" > /dev/console
echo "REGALIA-E2E-ATTACH dm: $(dmsetup table root 2>&1 | cut -d' ' -f1-4) crypttab-in-root: $(test -e /etc/crypttab && echo present || echo absent)" > /dev/console
echo "REGALIA-E2E-CMDLINE $(cat /proc/cmdline)" > /dev/console
# the PCRs once booted: PCR 11 is the image's booted-phase value; PCR 12 should be what the stub left
echo "REGALIA-E2E-PCRS 7=$(cat /sys/class/tpm/tpm0/pcr-sha256/7 2>&1) 11=$(cat /sys/class/tpm/tpm0/pcr-sha256/11 2>&1) 12=$(cat /sys/class/tpm/tpm0/pcr-sha256/12 2>&1)" > /dev/console
# what the unlock client left for the running system, after switch-root (public values)
echo "REGALIA-E2E-SESSION dir=$(stat -c '%U:%G:%a' /run/regalia 2>&1) id=$(cat /run/regalia/boot-session 2>&1) through=$(cat /run/regalia/key-given-through 2>&1 | tr -s ' \n' ' ')" > /dev/console
# whether systemd in the initrd imported credentials (the image's command line says it must not); its own
# message, kept in the journal across switch-root
imported=yes; journalctl -b -o cat --no-pager 2>/dev/null | grep -q "systemd.import_credentials=no is set, skipping importing of credentials" && imported=no
echo "REGALIA-E2E-IMPORT credentials-imported=$imported" > /dev/console
# and the client itself is gone: it held the local half and the boot session's private key
clients=0
for comm in /proc/[0-9]*/comm; do
    read -r name < "$comm" 2>/dev/null || continue
    [ "$name" = regalia-unlock ] && clients=$((clients + 1))
done
echo "REGALIA-E2E-CLIENT processes=$clients" > /dev/console
systemctl --no-block poweroff
