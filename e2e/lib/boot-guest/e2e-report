#!/bin/sh
# Inside the test guest, once the root filesystem is up: say so on the console, with what is left of
# the boot mesh (nothing should be), and power off.
mesh=absent; ip link show wg-boot >/dev/null 2>&1 && mesh=present
table=absent; nft list table inet regalia_boot >/dev/null 2>&1 && table=present
addresses="$(ip -o addr show scope global | wc -l)"       # IPv4 and IPv6
link=down; ip -o link show eth0 | grep -q "state UP" && link=up
mapped=no; [ -e /dev/mapper/root ] && mapped=yes
echo "REGALIA-E2E-ROOT-UP root=$mapped wg-boot=$mesh table=$table addresses=$addresses link=$link" > /dev/console
# THE VERITY /usr (#61 K61V-4), a proof on every boot: what /usr, / and /var are, and dm-verity's own word on /usr (its
# status, verified or corrupted, and the root hash the kernel holds). "root" is the LUKS mapping the initrd's crypttab
# names; it is /var now (the UKI's systemd.mount-extra=)
src(){ findmnt -no SOURCE "$1" 2>/dev/null | head -1; }
fstype(){ findmnt -no FSTYPE "$1" 2>/dev/null | head -1; }
verity="$(veritysetup status usr 2>&1)"
vstatus="$(printf '%s\n' "$verity" | sed -n 's/^[[:space:]]*status:[[:space:]]*//p' | head -1)"
vhash="$(printf '%s\n' "$verity" | sed -n 's/^[[:space:]]*root hash:[[:space:]]*//p' | head -1)"
echo "REGALIA-E2E-VERITY usr=$(src /usr):$(fstype /usr) root=$(src /):$(fstype /) var=$(src /var):$(fstype /var) status=${vstatus:-none} roothash=${vhash:-none}" > /dev/console
# Trigger the shipped automount and inspect only an exact vfat mount.
# mountinfo separates VFS options from filesystem options (the FAT masks).
esp=failed
target=""; source=""; partuuid=""; mtype=""; mopts=""; msuper=""; probe=none; bootcompeting=absent
if [ -d /efi/EFI ]; then
    line="$(awk '$5 == "/efi" {
        for (i = 7; i <= NF; i++)
            if ($i == "-" && $(i+1) == "vfat") {
                print $3, $5, $6, $(i+1), $(i+2), $(i+3)
                exit
            }
    }' /proc/self/mountinfo)"
    if [ -n "$line" ]; then
        read -r device target mopts mtype source msuper <<EOF
$line
EOF
        partuuid="$(lsblk --nodeps --raw --noheadings --output PARTUUID -- "$source")"
        # Exercise the old automount path as well so a competing mount is visible.
        test -d /boot/EFI || :
        if awk -v device="$device" '$3 == device && $5 == "/boot" { found = 1 }
            END { exit !found }' /proc/self/mountinfo; then
            bootcompeting=present
        fi
        if [ -n "$partuuid" ]; then
            probe=failed
            if marker="$(mktemp /efi/EFI/.e2e-mount-proof.XXXXXX)"; then
                written=no
                if printf 'esp-write-proof\n' > "$marker" && [ "$(cat "$marker")" = esp-write-proof ]; then
                    written=yes
                fi
                if rm -f "$marker" && [ "$written" = yes ]; then
                    probe=ok
                fi
            fi
            esp="$probe"
        fi
    fi
fi
echo "REGALIA-E2E-ESP mount=$esp source=$source partuuid=$partuuid type=$mtype options=$mopts super-options=$msuper probe=$probe boot-competing=$bootcompeting kernel=$(uname -r) modules-tree=$(test -d /usr/lib/modules && echo present || echo absent) target=$target" > /dev/console
if [ "$esp" != ok ]; then
    systemctl status efi.automount efi.mount --no-pager > /dev/console 2>&1
    dmesg | grep 'regalia-boot-esp:' > /dev/console
fi
# r1s.18 shares the same module-free rootfs: the boot must also be able to mount binfmt_misc.
binfmt=failed
mkdir -p /run/e2e-binfmt
if mount -t binfmt_misc binfmt_misc /run/e2e-binfmt; then binfmt=ok; umount /run/e2e-binfmt; fi
echo "REGALIA-E2E-BINFMT mount=$binfmt" > /dev/console
# which firmware entry booted: BootCurrent, and that entry as efibootmgr reads it (label, then its device path)
current="$(efibootmgr 2>/dev/null | sed -n 's/^BootCurrent: //p')"
entry="$(efibootmgr -v 2>/dev/null | grep "^Boot${current:-none}" | tr -s ' \t' ' ' | cut -c1-300)"
echo "REGALIA-E2E-BOOTENTRY current=${current:-none} entry=${entry:-none}" > /dev/console
# the machine ID PID 1 started with (from /var/lib/dbus/machine-id, kept on /var: etc-inventory.txt [boot]), whether
# this boot counts as a first boot, and what is enabled under /etc (nothing: the image's enablement is under /usr, and
# the preset pass a first boot runs enables nothing, units-enabled.txt)
firstboot=no; [ -e /run/systemd/first-boot ] && firstboot=yes
links="$(find /etc/systemd/system -type l 2>/dev/null | wc -l)"
echo "REGALIA-E2E-MACHINE id=$(cat /etc/machine-id 2>/dev/null || echo none) kept=$(cat /var/lib/dbus/machine-id 2>/dev/null || echo none) first-boot=$firstboot etc-links=$links" > /dev/console
# the units the image's /etc and its KMS depend on: whether each ran, and how it ended. ExecMainStartTimestampMonotonic
# is 0 for a service whose main process never started (a failed dependency, a failed assert)
for u in systemd-firstboot.service regalia-etc-factory.service systemd-sysusers.service apparmor.service chrony.service prometheus-node-exporter.service pcscd.socket regalia-kms.service; do
  st="$(systemctl show -P LoadState "$u" 2>/dev/null)/$(systemctl show -P ActiveState "$u" 2>/dev/null)/$(systemctl show -P Result "$u" 2>/dev/null)"
  started="$(systemctl show -P ExecMainStartTimestampMonotonic "$u" 2>/dev/null)"
  enabled="$(systemctl is-enabled "$u" 2>/dev/null | head -1)"
  echo "REGALIA-E2E-UNIT $u state=$st started=${started:-none} enabled=${enabled:-none}" > /dev/console
done
# THE EXPORTER'S STATE (regalia-kms-r1s.17): the enabled unit that reads the per-host EnvironmentFile. Skipped (its
# ConditionPathExists) when that file is not on /var: inactive, no restarts, no start limit, no listener. Started on
# the configured address when it is. NRestarts and the boot-scoped journal say a failure would not be hidden: a
# unit in failed/activating, or one that has retried, cannot read as the line a skipped unit leaves
restarts="$(systemctl show -P NRestarts prometheus-node-exporter.service 2>/dev/null || echo none)"
journal="$(journalctl -b -u prometheus-node-exporter.service -o cat --no-pager 2>/dev/null | grep -m4 -E 'Failed to load environment|Failed with result|Start request|start request|limit' | tr '\n' '|' | cut -c1-300)"
echo "REGALIA-E2E-EXPORTER unit=$(systemctl show -P ActiveState prometheus-node-exporter.service 2>/dev/null)/$(systemctl show -P SubState prometheus-node-exporter.service 2>/dev/null)/$(systemctl show -P ConditionResult prometheus-node-exporter.service 2>/dev/null || echo none) result=$(systemctl show -P Result prometheus-node-exporter.service 2>/dev/null || echo none) restarts=${restarts:-none}" > /dev/console
echo "REGALIA-E2E-EXPORTER journal=${journal:-none}" > /dev/console
# its listener, MEASURED (ss -ltnp, every address, not derived from the file's presence): 9100 on the address the
# per-host ARGS configure (only) when configured; nothing at all when the unit skipped (a package-default start
# would show the wildcard address, not 127.0.0.1). Also: the dangling /etc link (its target absent) and the settled
# is-system-running, which an unconfigured host must report as running
listen="$(ss -ltnp 2>/dev/null | awk 'NR>1 {print $4}' | grep -oE '[^ ]+:[0-9]+$' | sort -u | tr '\n' ',')"
[ -z "$listen" ] && listen=none
etclink="$(readlink /etc/default/prometheus-node-exporter 2>/dev/null || echo none)"
etctarget=absent; [ -e /etc/default/prometheus-node-exporter ] && etctarget=present
# the system's health, without deadlocking: the report is a oneshot in multi-user.target, so is-system-running
# --wait would wait for itself to finish. Instead, count the failed units: a unit in failed state (the exporter's
# build-8 failure shape: start limit, result resources) holds the system in "degraded". Zero failed units means
# the system settles to "running" once the transitions complete. The test asserts failed-units=0 on an
# unconfigured boot (AC1: the skipped exporter does not degrade the host)
failed="$(systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l)"
echo "REGALIA-E2E-EXPORTER listen=$listen etclink=$etclink etctarget=$etctarget failed-units=$failed" > /dev/console
# THE MUTUAL-TLS PROBE (regalia-kms-r1s.17, the boot where the test's web.yml and server material are staged):
# the metrics are served only to a client the monitoring CA authenticated. Each case is a bounded probe:
# trusted (a certificate the monitoring CA signed for the test), missing (no client certificate) and wrong (a
# certificate from another CA). The probe VERIFIES the server certificate against the monitoring CA (loaded from
# /mnt/enrol/node-exporter.monitoring-ca.pem, staged by e2e-enrol beside the client fixtures), so a server that
# presents no valid certificate is caught here, not hidden. The negative cases fail on the CLIENT side's
# certificate check (the server's RequireAndVerifyClientCert), not on server verification: the server cert is
# verified in all three cases, and only the client cert differs
# the probes run only when the exporter is ACTIVE (not just when its files are on /var: on the enrolment boot,
# e2e-enrol writes the files after multi-user.target was reached, so the exporter is skipped and nothing is
# listening — the probes would just fail with "connection refused" and waste the boot's time budget)
exporter_active="$(systemctl show -P ActiveState prometheus-node-exporter.service 2>/dev/null)"
if [ "$exporter_active" = active ] && [ -f /var/lib/regalia-etc/regalia/node-exporter/server.pem ] && [ -f /var/lib/regalia-etc/default/prometheus-node-exporter ]; then
  address="$(sed -n 's/.*--web\.listen-address=\([^ :"]*:[0-9]*\).*/\1/p' /var/lib/regalia-etc/default/prometheus-node-exporter | head -1)"
  # the probe's inputs are on /var (e2e-enrol copied them there: the enrolment disk is only attached on v1,
  # the probes run on v2c, where the disk is gone)
  probe_dir=/var/lib/regalia-etc/regalia/node-exporter
  cafile=$probe_dir/monitoring-ca.pem
  probe() {  # probe <name> <client-cert-file|-> <client-key-file|->: one bounded TLS GET. The guest has no
    # curl (packages.txt), so python3's ssl does it: a 200 is "ok" with the body's node_ line count; any other
    # code is "denied" with the code; a handshake refusal (RequireAndVerifyClientCert with no, or a foreign,
    # client certificate) is "refused" with the ssl error. The server certificate is VERIFIED against the
    # monitoring CA (check_hostname on, verify_mode CERT_REQUIRED): a server that does not present a valid
    # certificate for this address fails here, not in the client-cert check
    name=$1; cert=$2; key=$3
    probeout=$(python3 -I - "$address" "$cert" "$key" "$cafile" <<'PYEOF' 2>&1 | tr '\n' ' ' | cut -c1-200
import socket, ssl, sys
address, cert, key, cafile = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
if not address or address == "-":
    print("refused no-address"); sys.exit(0)
host, port = address.rsplit(":", 1)
ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
ctx.load_verify_locations(cafile)
ctx.check_hostname = True
ctx.verify_mode = ssl.CERT_REQUIRED
if cert:
    ctx.load_cert_chain(cert, key)
sock = socket.create_connection((host, int(port)), timeout=5)
try:
    tls = ctx.wrap_socket(sock, server_hostname=host)
    request = ("GET /metrics HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n").encode()
    tls.sendall(request)
    data = b""
    while True:
        chunk = tls.recv(65536)
        if not chunk:
            break
        data += chunk
finally:
    sock.close()
head, _, body = data.partition(b"\r\n\r\n")
code = head.split(b" ", 2)[1].decode()
print("ok %d %d" % (int(code), body.count(b"\nnode_")))
PYEOF
    )
  if printf '%s' "$probeout" | grep -q '^refused'; then
    echo "REGALIA-E2E-PROBE $name http=refused reason=${probeout#refused }" > /dev/console
  else
    echo "REGALIA-E2E-PROBE $name http=$probeout" > /dev/console
  fi
  }
  trusted=$probe_dir/node-exporter.client.crt
  wrong=$probe_dir/node-exporter.client-wrong.crt
  probe trusted "$trusted" $probe_dir/node-exporter.client.key
  probe missing - -
  probe wrong "$wrong" $probe_dir/node-exporter.client-wrong.key
  # plaintext: a non-TLS connection to the TLS-only server must be refused (web.yml is TLS 1.3 only)
  plainout=$(python3 -I - "$address" <<'PYEOF' 2>&1 | tr '\n' ' ' | cut -c1-200
import socket, sys
address = sys.argv[1]
if not address or address == "-":
    print("refused no-address"); sys.exit(0)
host, port = address.rsplit(":", 1)
sock = socket.create_connection((host, int(port)), timeout=5)
try:
    sock.sendall(b"GET /metrics HTTP/1.1\r\nHost: " + host.encode() + b"\r\nConnection: close\r\n\r\n")
    data = sock.recv(65536)
finally:
    sock.close()
if data.startswith(b"HTTP"):
    code = data.split(b" ", 2)[1].decode()
    print("ok %d" % int(code))
else:
    print("refused non-tls")
PYEOF
  )
  if printf '%s' "$plainout" | grep -q '^refused'; then
    echo "REGALIA-E2E-PROBE plaintext http=refused reason=${plainout#refused }" > /dev/console
  else
    echo "REGALIA-E2E-PROBE plaintext http=$plainout" > /dev/console
  fi
  echo "REGALIA-E2E-PROBE done" > /dev/console
fi
# THE PER-HOST UNITS (regalia-kms-r1s.8): what the image enables under /usr gated on a per-host file (units-enabled.txt
# [per-host]): the firewall, and every regalia-* unit its multi-user and timers targets want. ConditionResult says whether
# the gate let it start ("no": the per-host file is not there), AssertResult whether an assert held (regalia-kms: the ruleset)
for u in nftables.service regalia-kms.service $(ls /usr/lib/systemd/system/multi-user.target.wants /usr/lib/systemd/system/timers.target.wants 2>/dev/null \
                                                  | grep -E '^regalia-' | grep -vE '^regalia-(e2e-|kms\.service)' | sort -u); do
  st="$(systemctl show -P LoadState "$u" 2>/dev/null)/$(systemctl show -P ActiveState "$u" 2>/dev/null)/$(systemctl show -P Result "$u" 2>/dev/null)"
  started="$(systemctl show -P ExecMainStartTimestampMonotonic "$u" 2>/dev/null)"
  case "$u" in *.timer|*.path) started="$(systemctl show -P ActiveEnterTimestampMonotonic "$u" 2>/dev/null)" ;; esac
  echo "REGALIA-E2E-UNIT $u state=$st started=${started:-none} enabled=gated condition=$(systemctl show -P ConditionResult "$u" 2>/dev/null || echo none) assert=$(systemctl show -P AssertResult "$u" 2>/dev/null || echo none)" > /dev/console
done
# the firewall the kernel holds: firewall.py's table, and its input chain's policy
fw=absent; nft --terse list table inet regalia_kms >/dev/null 2>&1 && fw=loaded
policy="$(nft --terse list chain inet regalia_kms input 2>/dev/null | grep -o 'policy [a-z]*' | head -1 | cut -d' ' -f2)"
echo "REGALIA-E2E-FIREWALL table=$fw input-policy=${policy:-none} ruleset-file=$(test -e /etc/nftables.d/regalia-kms.nft && echo present || echo absent)" > /dev/console
# the KMS unit's drop-ins as systemd merged them (the image's, and the generator's for this host's PIN credentials)
echo "REGALIA-E2E-KMSUNIT dropins=$(systemctl show -P DropInPaths regalia-kms.service 2>/dev/null | tr ' ' ',') credentials=$(systemctl show -P LoadCredentialEncrypted regalia-kms.service 2>/dev/null | tr ' ' ',')" > /dev/console
# /var was mounted IN THE INITRD (the UKI's systemd.mount-extra=...:x-initrd.mount): the initrd's own journal line for
# /sysroot/var, kept across switch-root, and the boot's first line naming the real root's var.mount, if any
initrdvar="$(journalctl -b -o cat --no-pager 2>/dev/null | grep -m1 -o 'Mounted sysroot-var.mount.*' | tr -s ' ' | cut -c1-120)"
echo "REGALIA-E2E-VARMOUNT initrd=${initrdvar:-none}" > /dev/console
# These are the three Regalia services installed in the initrd. Read their
# retained current-boot journal because their unit objects are gone after switch-root.
for u in regalia-boot-render regalia-wg-boot regalia-unlock; do
    if records="$(journalctl -b -u "$u.service" -o cat --no-pager 2>/dev/null)"; then
        printf '%s\n' "$records" |
            sed -nE "/expected pre-genesis skip|regalia[.]site|Failed with result|Failed to start|Failed to set up credentials|243\/CREDENTIALS|^(Starting|Started|Finished) /s/^/REGALIA-E2E-INITRD $u /p" > /dev/console
        echo "REGALIA-E2E-INITRD $u journal=ok" > /dev/console
    else
        echo "REGALIA-E2E-INITRD $u journal=failed" > /dev/console
    fi
done
# whether the factory copy's assert held (AssertPathIsDirectory=/usr/share/factory/etc): "no" on a broken image
echo "REGALIA-E2E-FACTORY assert=$(systemctl show -P AssertResult regalia-etc-factory.service 2>/dev/null || echo none)" > /dev/console
# AppArmor: is the daemon's profile loaded, and in which mode (the kernel's own list)
profile="$(grep -E '^regalia-kms \(' /sys/kernel/security/apparmor/profiles 2>/dev/null | head -1)"
# ... and chronyd's, by the process: the profile its running chronyd is confined by (attr/current), so "enforce" is
# AppArmor's own word on the daemon that reads its configuration through /etc's link to /var
chronyd=""
for comm in /proc/[0-9]*/comm; do
  read -r name < "$comm" 2>/dev/null || continue
  if [ "$name" = chronyd ]; then
    p="${comm%/comm}"; chronyd="$(cat "$p/attr/apparmor/current" 2>/dev/null || cat "$p/attr/current" 2>/dev/null)"; break
  fi
done
echo "REGALIA-E2E-CHRONYD confined=${chronyd:-none}" > /dev/console
echo "REGALIA-E2E-APPARMOR enabled=$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null || echo absent) regalia-kms=${profile:-none} etc-passwd=$(test -s /etc/passwd && echo present || echo absent)" > /dev/console
# What is left, on the running host, of what opened the root volume. MEASURED: nothing that names the
# key file. The unit the initrd generated is not loaded after switch-root (LoadState=not-found) and
# /run/systemd/generator holds the real root's units only. A probe on the running host cannot read
# the initrd's crypttab entry from systemd; it has to read the initrd image.
echo "REGALIA-E2E-ATTACH unit: $(systemctl show 'systemd-cryptsetup@root.service' -p LoadState,ActiveState,FragmentPath,ExecStart 2>&1 | tr -s ' \n' ' ' | cut -c1-400)" > /dev/console
echo "REGALIA-E2E-ATTACH generator: $(ls /run/systemd/generator /run/systemd/generator.late 2>&1 | tr -s ' \n' ' ' | cut -c1-300)" > /dev/console
echo "REGALIA-E2E-ATTACH dm: $(dmsetup table root 2>&1 | cut -d' ' -f1-4) crypttab-in-root: $(test -e /etc/crypttab && echo present || echo absent)" > /dev/console
echo "REGALIA-E2E-CMDLINE $(cat /proc/cmdline)" > /dev/console
# the PCRs once booted: PCR 11 is the image's booted-phase value; PCR 12 should be what the stub left. Read only
# once systemd-pcrphase.service has measured `ready` (#310: a read before it is the sysinit value, one phase
# short). The unit orders it; this says what it saw, so a regression fails by name, not as a PCR mismatch.
# One property per call: `show -p A,B --value` prints in systemd's own order (Result before ActiveState), not the
# order asked (regalia-kms-d9, measured on Debian 13's systemd 257)
phase="$(systemctl show -P ActiveState systemd-pcrphase.service 2>&1) $(systemctl show -P Result systemd-pcrphase.service 2>&1)"
echo "REGALIA-E2E-PCRPHASE systemd-pcrphase.service=$phase" > /dev/console
echo "REGALIA-E2E-PCRS 7=$(cat /sys/class/tpm/tpm0/pcr-sha256/7 2>&1) 11=$(cat /sys/class/tpm/tpm0/pcr-sha256/11 2>&1) 12=$(cat /sys/class/tpm/tpm0/pcr-sha256/12 2>&1)" > /dev/console
# what the unlock client left for the running system, after switch-root (public values)
echo "REGALIA-E2E-SESSION dir=$(stat -c '%U:%G:%a' /run/regalia 2>&1) id=$(cat /run/regalia/boot-session 2>&1) through=$(cat /run/regalia/key-given-through 2>&1 | tr -s ' \n' ' ')" > /dev/console
# whether systemd in the initrd imported credentials (the image's command line says it must not); its own
# message, kept in the journal across switch-root
imported=yes; journalctl -b -o cat --no-pager 2>/dev/null | grep -q "systemd.import_credentials=no is set, skipping importing of credentials" && imported=no
echo "REGALIA-E2E-IMPORT credentials-imported=$imported" > /dev/console
# and the client itself is gone: it held the local half and the boot session's private key
clients=0
for comm in /proc/[0-9]*/comm; do
    read -r name < "$comm" 2>/dev/null || continue
    [ "$name" = regalia-unlock ] && clients=$((clients + 1))
done
echo "REGALIA-E2E-CLIENT processes=$clients" > /dev/console
# whether the kernel really zeroes pages it frees and hands out (#221): the words are on the command line,
# but a kernel built without the options, or with a debug option that excludes them, ignores them. The
# kernel says what it enabled at boot (an info message, kept in the ring buffer whatever the loglevel).
echo "REGALIA-E2E-MEMINIT $(dmesg 2>/dev/null | grep -o 'mem auto-init:.*' | head -1)" > /dev/console
systemctl --no-block poweroff
