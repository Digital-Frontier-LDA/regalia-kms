[Service]
# On a host that is NOT the verity-/usr KMS host image: install as a drop-in of regalia-kms.service
# (credentials.conf) only after creating these TPM2-sealed blobs interactively on the KMS host.
# On the image, install nothing: its generator (deploy/baremetal/generators/regalia-kms-credentials) names each
# sealed regalia-kms-<id>.pin in the host's credstore at every boot, and units/regalia-kms.service.d/memlock.conf
# sets the limit (regalia-kms-r1s.8: the image's /etc/systemd/system is empty at every boot).
LoadCredentialEncrypted=hsm-site-a.pin:/etc/credstore.encrypted/regalia-kms-hsm-site-a.pin
LoadCredentialEncrypted=yubi-site-a.pin:/etc/credstore.encrypted/regalia-kms-yubi-site-a.pin
LimitMEMLOCK=1M
