# The real unlock client's own socket (regalia-kms#66): only the relay on the key socket connects to it.
# A connection starts regalia-unlock.service, with its credentials. If that service cannot start (a
# credential absent or refused), this socket fails, the relay's connection is reset, and the relay gives
# systemd-cryptsetup nothing: the console asks for the recovery key.

[Unit]
Description=Socket of the unlock client, behind the key socket's relay
Documentation=https://github.com/Digital-Frontier-LDA/regalia-kms/blob/main/deploy/baremetal/README.md
DefaultDependencies=no
Before=sockets.target cryptsetup-pre.target
Conflicts=shutdown.target
Before=shutdown.target

[Socket]
ListenStream=/run/regalia-unlock-core/core.sock
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes
Service=regalia-unlock.service

[Install]
WantedBy=sockets.target
