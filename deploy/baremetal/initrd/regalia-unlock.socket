# The socket systemd-cryptsetup reads the root volume's key from (regalia-kms#67, #66).
#
# crypttab names this path as the volume's key file:
#
#     root  UUID=…  /run/regalia-unlock/key.sock  luks
#
# systemd-cryptsetup connects to it; that connection starts regalia-unlock.service, which asks a peer and
# writes the key to the connection, or closes it with nothing. The path is unlock.KEY_SOCKET in
# deploy/baremetal/unlock.py, and host_probe checks crypttab against it.

[Unit]
Description=Key socket of the root volume (TPM plus one peer)
Documentation=https://github.com/Digital-Frontier-LDA/regalia-kms/blob/main/deploy/baremetal/README.md
DefaultDependencies=no
Before=sockets.target cryptsetup-pre.target
Conflicts=shutdown.target
Before=shutdown.target

[Socket]
ListenStream=/run/regalia-unlock/key.sock
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
