# The pre-root unlock client (cmd/regalia-unlock), started by a connection on regalia-unlock.socket.
#
# systemd does two things for it, and the program does neither itself:
#   - it unseals the local half of the disk credential with the TPM (LoadCredentialEncrypted=). On
#     another machine, or on a boot the TPM's policy refuses, that fails and the program never starts;
#   - it passes the listening socket (socket activation).
# The program runs no other program and writes no secret anywhere. It stays for as long as the initrd
# lasts and answers each connection with the key or with nothing, always under the ONE boot session it
# made when it started: a peer accepts one session per boot. systemd stops it before the root filesystem
# takes over; it zeroes the local half, the key and the session's private key and ends. Started again in
# the same boot (after a crash), it finds the first one's session on record and asks no peer.

[Unit]
Description=Give the root volume's key: TPM plus one peer
Documentation=https://github.com/Digital-Frontier-LDA/regalia-kms/blob/main/deploy/baremetal/README.md
DefaultDependencies=no
Requires=regalia-unlock.socket
# the local half is unsealed with the TPM: not before its device is there
Wants=tpm2.target
# and, in a measured boot, not before the initrd's phase is in PCR 11: the quote must show that phase
After=tpm2.target systemd-pcrphase-initrd.service
# the boot mesh, when the initrd has it (#66); without that unit this line does nothing
Wants=regalia-wg-boot.service
After=regalia-wg-boot.service
# it holds the local half and the boot session's private key: it does not outlive the initrd
Conflicts=initrd-switch-root.target shutdown.target
Before=initrd-switch-root.target shutdown.target

[Service]
Type=exec
ExecStart=/usr/bin/regalia-unlock -config /etc/regalia/unlock.json
LoadCredentialEncrypted=regalia-unlock-local:/etc/regalia/unlock-local.cred
# What it leaves for the running system: the boot session's ID and public key, and who opened the disk,
# in /run/regalia. The directory is root's, 0755, and stays when this unit ends and across switch-root:
# the lease service and the KMS daemon read and write there after boot.
RuntimeDirectory=regalia
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# it holds secrets for the whole initrd phase: no core file, whatever the image's defaults
LimitCORE=0
# The program is root with nothing root can do: no capability, no new privilege, no write anywhere but
# that directory, no device but the TPM and the disks it reads the LUKS2 header of, no socket family but
# the three it uses.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=block-* r
UMask=0077
