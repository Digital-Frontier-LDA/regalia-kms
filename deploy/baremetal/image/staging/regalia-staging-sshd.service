# STAGING IMAGE VARIANT ONLY (build-rootfs.sh --variant staging, regalia-kms-dx7.14): the staging operator's
# evidence access. Never in the production image (deploy/baremetal/imagevariant.py). Key-only, for root, with the keys
# this host's staging install wrote to /var; refused unless the signed kernel command line says regalia.staging=1, and
# only reachable where the host's TEST firewall lets it (the staging management net). This is NOT the production
# image's sshd question (regalia-kms-r1s.12, owner question q-20).
[Unit]
Description=Regalia STAGING operator SSH (staging image only, key-only)
ConditionKernelCommandLine=regalia.staging=1
ConditionPathExists=/var/lib/regalia-staging/authorized_keys
After=network.target

[Service]
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
ExecStartPre=/bin/sh -c 'test -e /var/lib/regalia-staging/ssh/ssh_host_ed25519_key || /usr/bin/ssh-keygen -q -t ed25519 -N "" -f /var/lib/regalia-staging/ssh/ssh_host_ed25519_key'
ExecStartPre=/usr/sbin/sshd -t -f /usr/lib/regalia-staging/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /usr/lib/regalia-staging/sshd_config
Restart=on-failure

[Install]
WantedBy=multi-user.target
