# STAGING IMAGE VARIANT ONLY (build-rootfs.sh --variant staging, regalia-kms-dx7.14): the staging operator's
# evidence access. Never in the production image (deploy/baremetal/imagevariant.py). Key-only, for root, with the keys
# this host's staging install wrote to /var; refused unless the signed kernel command line says regalia.staging=1, and
# only reachable where the host's TEST firewall lets it (the staging management net). This is NOT the production
# image's sshd question (regalia-kms-r1s.12, owner question q-20).
[Unit]
Description=Regalia STAGING operator SSH (staging image only, key-only)
ConditionKernelCommandLine=regalia.staging=1
ConditionPathExists=/var/lib/regalia-staging/authorized_keys
# the ListenAddress is the host's static staging address: sshd cannot bind it before networkd has configured it, so it
# waits for network-online (systemd-networkd-wait-online, which the staging variant enables) (regalia-kms-dx7.36)
Wants=network-online.target
After=network-online.target
# a refused host key (or drop-in) is deterministic: five starts within two minutes, then the unit stays failed, naming
# the cause in its journal, instead of retrying every RestartSec forever (regalia-kms-u2t); a late address (dx7.36)
# still has its five tries
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
# the per-host drop-ins may hold ONLY ListenAddress and AllowUsers: any other keyword, Match included, refuses the start
ExecStartPre=/usr/lib/regalia-staging/sshd-dropins-check.sh
# the host key is the bundled one stage-perhost installed (regalia-kms-u2t): sshd never makes one, so a missing key
# refuses the start by name instead of serving a new key the operator would have to trust on first use
ExecStartPre=/usr/lib/regalia-staging/sshd-hostkey-check.sh
ExecStartPre=/usr/sbin/sshd -t -f /usr/lib/regalia-staging/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /usr/lib/regalia-staging/sshd_config
Restart=on-failure
# a margin, so a late address cannot run out the start limit in one second as it did on build 8 (regalia-kms-dx7.36)
RestartSec=5s

[Install]
WantedBy=multi-user.target
