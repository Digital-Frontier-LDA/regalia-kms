# Whether this host's time is authenticated (#69, #80): asks chrony every 15 s and writes
# /run/regalia/authtime.json, which the other services believe for 60 s (deploy/baremetal/authtime.py).
# chronyc answers `authdata` only over chrony's Unix command socket, in /run/chrony (owned by _chrony),
# and binds a socket of its own there. Observed under systemd on Ubuntu 24.04's chrony 4.5
# (e2e/node-units-systemd.py): the directory is 0700 after chrony starts, even when made group-writable
# before, so the _chrony group grants nothing there and access rests on ONE capability,
# CAP_DAC_OVERRIDE. (The group stays for a distribution that leaves the directory 0750. Running as
# _chrony instead would let a compromised chronyd, which parses NTP from the network, forge the status:
# the readers accept it only from root.) What that leaves this service: chronyd's whole command socket
# (it could add sources or step the clock it vouches for), and, as root, every file in /run/regalia
# (the admission file and the boot session included). Nothing else: no network, and an empty /etc,
# /var and /run around it but for its configuration and those two directories.
[Unit]
Description=Regalia KMS: is time authenticated (chrony, NTS)
Documentation=https://github.com/Digital-Frontier-LDA/regalia-kms/blob/main/deploy/baremetal/README.md
# After=, never Wants=: chronyd that has exited (maxchange, #303) stays down until an operator starts it. A
# Wants= here would start it again whenever this unit restarts, and a fresh chronyd steps to whatever two
# sources agree on during its first updates.
After=chrony.service

[Service]
Type=simple
WorkingDirectory=/usr/lib/regalia-kms
# wg, ip, tpm2_*, chronyc and openssl are run by name: from these directories only
Environment=PATH=/usr/sbin:/usr/bin
ExecStart=/usr/bin/python3 -Es -m deploy.baremetal.node --config /etc/regalia/node.json authtime
Restart=always
RestartSec=5s
User=root
SupplementaryGroups=_chrony
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/regalia /run/chrony /var/log/regalia-time -/run/regalia-metrics/authtime
# CAP_DAC_OVERRIDE would let it read any file it can see, so it sees almost none: /etc is an empty
# read-only tmpfs with only its own configuration and what the C library needs bound into it, /var is
# empty, and other processes are invisible under /proc. (Not ProcSubset=pid: the kernel's boot ID,
# under /proc/sys, is part of the status it writes.)
TemporaryFileSystem=/etc:ro /var:ro /run:ro
# /run likewise: other units' credentials (/run/credentials) and whatever else is staged there stay out
# of sight; only the two directories it writes are bound back
# and the time trail's directory (#303): each transition is recorded there before it is published
BindPaths=/run/regalia /run/chrony /var/log/regalia-time -/run/regalia-metrics/authtime
# and its metrics directory (#305; "-": a missing one never stops the time service, the file's age alerts), and, read only,
# the latch's whole directory: it holds the latch and nothing else (regalia.tmpfiles.conf, 0700 root), and "-" because a
# directory that is missing holds no latch either; the chrony latch's directory, for regalia_chrony_latch_set
BindReadOnlyPaths=/etc/regalia/node.json /etc/passwd /etc/group /etc/nsswitch.conf /etc/ld.so.cache -/etc/localtime -/var/lib/regalia-time
ProtectProc=invisible
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
LimitCORE=0

[Install]
WantedBy=multi-user.target
