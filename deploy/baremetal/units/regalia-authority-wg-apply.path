# Re-run regalia-authority-wg-apply whenever the authority publishes a new chain (after init, accept, and
# every revocation's commit): a revoked node leaves the authority's tunnel with the manifest that says so.
[Unit]
Description=Regalia KMS: re-apply the authority's tunnel when the membership chain changes

[Path]
PathChanged=/var/lib/regalia-authority/chain.json
Unit=regalia-authority-wg-apply.service

[Install]
WantedBy=multi-user.target
