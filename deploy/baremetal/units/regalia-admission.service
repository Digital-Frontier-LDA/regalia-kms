# This node's runtime lease, and the admission file the KMS daemon reads (deploy/baremetal/admission.py).
# Its own user, regalia-admission (regalia.sysusers.conf), not root (#191): it asks the peers for a lease
# over the service tunnel, nowhere else, and parses their answers. It writes one directory,
# /run/regalia/admission (that user's, regalia.tmpfiles.conf), and the KMS daemon accepts the file there
# only from that user (its runtime_admission_owner) or root. It reads the boot session root left in
# /run/regalia (the unlock client's, or regalia-boot-session.service's) and cannot write it.
[Unit]
Description=Regalia KMS: the runtime lease and the admission file
Documentation=https://github.com/Digital-Frontier-LDA/regalia-kms/blob/main/deploy/baremetal/README.md
After=regalia-wg-apply.service regalia-authtime.service regalia-boot-session.service
Wants=regalia-wg-apply.service regalia-authtime.service
# no session, no lease: without it this service has nothing to ask with, and must not make one
Requires=regalia-boot-session.service

[Service]
Type=simple
WorkingDirectory=/usr/lib/regalia-kms
# wg, ip, tpm2_*, chronyc and openssl are run by name: from these directories only
Environment=PATH=/usr/sbin:/usr/bin
ExecStart=/usr/bin/python3 -Es -m deploy.baremetal.node --config /etc/regalia/node.json admission
Restart=always
RestartSec=5s
User=regalia-admission
Group=regalia-admission
# the TPM (its quotes, the anchor) is the tss group's
# regalia-audit-admission: the reader group of this service's audit trail, which it gives the file (#286)
SupplementaryGroups=tss regalia-audit-admission
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# Its own directory under root's /run/regalia, made by tmpfiles and never declared as this unit's
# RuntimeDirectory: systemd would remove it when this unit stops, and the last admission file must
# stand until it runs out by itself (admission.py).
ReadWritePaths=/run/regalia/admission
StateDirectory=regalia-admission
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
RestrictAddressFamilies=AF_UNIX AF_INET6
IPAddressDeny=any
IPAddressAllow=fd72:6567:6c61::/48
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
LimitCORE=0

[Install]
WantedBy=multi-user.target
