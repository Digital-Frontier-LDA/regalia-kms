# Removes the archived files of the audit trail %i that the audit collector has committed
# (deploy/baremetal/trails.py prune; #278). A trail rotates into <trail>.<last seq> files as it grows.
# An archive is removed only when regalia-audit-ship@%i's last pass recorded it as wholly behind the
# collector's committed line, and its last line on disk is the one recorded. The prune marker
# (<trail>.pruned) is written first, so the shipper goes on from it and still checks the collector's
# head. Run daily by regalia-audit-prune@%i.timer.
#
# Root with CAP_DAC_OVERRIDE only: the archives are in their writers' directories. It may write only
# the trail directories (the ones a host has; the others are skipped).
[Unit]
Description=Regalia KMS: remove the committed archives of the %i audit trail
Documentation=https://github.com/Digital-Frontier-LDA/regalia-kms/blob/main/deploy/baremetal/README.md

[Service]
Type=oneshot
EnvironmentFile=/etc/regalia/audit-ship/%i.env
ExecStart=/usr/bin/python3 -Es /usr/lib/regalia-kms/deploy/baremetal/trails.py prune ${TRAIL_PATH} /var/lib/regalia-audit-ship/%i.head.json
User=root
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/regalia-sync -/run/regalia/admission -/var/lib/regalia-authority -/var/log/regalia
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
LimitCORE=0
