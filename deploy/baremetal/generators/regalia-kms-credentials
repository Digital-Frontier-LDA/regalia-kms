#!/bin/sh
# /usr/lib/systemd/system-generators/regalia-kms-credentials (regalia-kms-r1s.8): regalia-kms.service's PIN credentials,
# this host's, named to systemd at every boot.
#
# WHY A GENERATOR: the credential IDs are this host's (seal-hsm-pin.sh --id: one per token), so no drop-in in the image
# can name them, and a drop-in under /etc/systemd/system is gone at every boot (/ is a tmpfs, /etc made from the image,
# and EMPTY when PID 1 loads units). The sealed files are this host's own, on /var: seal-hsm-pin.sh writes
# /var/lib/regalia-etc/credstore.encrypted/regalia-kms-<id>.pin (hostpaths.persistent; /etc/credstore.encrypted links
# there). PID 1 runs generators before it loads units, when /var is already mounted (by the initrd: the UKI's
# systemd.mount-extra=) and /etc is not made yet, so this reads the /var name, and again at each daemon-reload.
#
# WHAT IT WRITES: one drop-in, $1/regalia-kms.service.d/50-regalia-credentials.conf, with one line per sealed file:
#   LoadCredentialEncrypted=<id>.pin:/etc/credstore.encrypted/regalia-kms-<id>.pin
# exactly the line seal-hsm-pin.sh prints (the /etc name, the link: PIN-CUSTODY.md's deployment check accepts sources
# under /etc/credstore.encrypted/regalia-kms- only). Nothing else: no other setting can come from /var, which is not
# measured; the unit's sandbox, AppArmor profile and firewall are the image's (regalia-kms.service.d).
# Only a REGULAR file whose name is regalia-kms-<id>.pin with <id> as seal-hsm-pin.sh allows it (lower-case words
# joined by '-') is named: its kept copies (.prev-<time>), its temporaries (dot files), links and anything else are
# left out, each said on stderr (the journal). A missing credstore names nothing; a generator never fails the boot.
# The daemon's config.json (pin_paths) says which it needs: one it needs and this did not name fails its start.
#
# Arguments: systemd's three output directories (the first, "normal", is used). A fourth, the credstore to read, is for
# the tests only (tests/test_baremetal_per_host_units.py); systemd never passes one.
set -eu
export LC_ALL=C
out="${1:?a generator is given its output directory}"
store="${4:-/var/lib/regalia-etc/credstore.encrypted}"
lines=""
for f in "$store"/regalia-kms-*.pin; do
  [ -e "$f" ] || [ -L "$f" ] || continue                # the glob matched nothing
  name="${f##*/}"
  id="${name#regalia-kms-}"; id="${id%.pin}"
  if [ -L "$f" ] || [ ! -f "$f" ]; then
    echo "regalia-kms-credentials: $name is not a regular file: not named" >&2; continue
  fi
  case "$id" in
    ""|-*|*-|*--*|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) echo "regalia-kms-credentials: $name: '$id' is not a seal-hsm-pin.sh --id: not named" >&2; continue ;;
  esac
  lines="$lines
LoadCredentialEncrypted=$id.pin:/etc/credstore.encrypted/$name"
done
[ -n "$lines" ] || exit 0
mkdir -p "$out/regalia-kms.service.d"
{
  echo "# Generated at boot by /usr/lib/systemd/system-generators/regalia-kms-credentials from $store (regalia-kms-r1s.8)"
  echo "[Service]"
  printf '%s\n' "$lines" | sed '/^$/d'
} > "$out/regalia-kms.service.d/50-regalia-credentials.conf"
