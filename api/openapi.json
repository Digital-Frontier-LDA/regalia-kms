{
  "openapi": "3.1.0",
  "info": {
    "title": "Regalia KMS API",
    "version": "1.0.0",
    "description": "Purpose-shaped hardware-backed cryptographic operations. Version 1 is a contract; no production implementation is implied."
  },
  "servers": [
    {
      "url": "https://kms.example.invalid"
    }
  ],
  "security": [
    {
      "mutualTLS": []
    }
  ],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "operations"
    },
    {
      "name": "secrets"
    },
    {
      "name": "objects"
    }
  ],
  "paths": {
    "/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive; contains no dependency detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Required dependencies are ready; contains no dependency detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "One or more required dependencies are unavailable; contains no detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/metrics": {
      "get": {
        "operationId": "getMetrics",
        "tags": [
          "health"
        ],
        "summary": "Operational metrics in Prometheus text exposition format.",
        "description": "Requires an authenticated client whose SPIFFE identity is listed in metrics_reader_principals. Label values are drawn only from static configuration (route paths, custody-manifest device ids, fixed enums) \u2014 never from request data.",
        "responses": {
          "200": {
            "description": "The current metric series.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "No verified client identity."
          },
          "403": {
            "description": "The authenticated identity is not a configured metrics reader."
          }
        }
      }
    },
    "/v1/operations/certificate-sign": {
      "post": {
        "operationId": "certificateSign",
        "tags": [
          "operations"
        ],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Must exactly equal context.nonce; every value is accepted at most once.",
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnwrapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized unwrapped data key.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/InvalidOperation"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "summary": "Sign a certificate request",
        "description": "Issues a certificate from a PKCS#10 CSR in DER, at most 8 KiB. The CSR is a request, not an instruction: the issuer profile decides the namespace, lifetime and key usage."
      }
    },
    "/v1/operations/key-agreement": {
      "post": {
        "operationId": "keyAgreement",
        "tags": [
          "operations"
        ],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Must exactly equal context.nonce; every value is accepted at most once.",
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnwrapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized unwrapped data key.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/InvalidOperation"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "summary": "Derive a shared key",
        "description": "Performs ECDH against a peer public key in PKIX DER, at most 4 KiB, and returns a 32-byte key derived through HKDF-SHA256 bound to the request context. The raw shared secret is never returned."
      }
    },
    "/v1/operations/release-secret": {
      "post": {
        "operationId": "releaseSecret",
        "tags": [
          "operations"
        ],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Must exactly equal context.nonce; every value is accepted at most once.",
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseSecretRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized secret plaintext.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/InvalidOperation"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "summary": "Release an enveloped secret",
        "description": "Unwraps a regalia-envelope-v2 envelope of at most 64 KiB and returns the secret plaintext. The envelope must belong to the object the route authorised."
      }
    },
    "/v1/operations/seal-envelope": {
      "post": {
        "operationId": "sealEnvelope",
        "tags": [
          "operations"
        ],
        "summary": "Produce a regalia-envelope-v2 document for a secret the caller encrypted locally.",
        "description": "The request carries the assembled parts (ciphertext, nonce, data key) and never the plaintext. The KMS proves possession of the data key by a local AEAD round-trip, then wraps the key against the object's commissioned KEK. The response is the envelope document; the KMS stores no copy.",
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Must exactly equal context.nonce; every value is accepted at most once.",
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SealEnvelopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The sealed envelope.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          }
        }
      }
    },
    "/v1/operations/sign": {
      "post": {
