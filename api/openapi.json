  "components": {
    "securitySchemes": {
      "mutualTLS": {
        "type": "mutualTLS",
        "description": "Client certificate mapped to a workload principal."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "enum": [
              "INVALID_ARGUMENT",
              "UNAUTHENTICATED",
              "DENIED",
              "NOT_FOUND",
              "CONFLICT",
              "INVALID_OPERATION",
              "BACKEND_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE",
              "RESOURCE_EXHAUSTED",
              "CANCELED",
              "DEADLINE_EXCEEDED",
              "INTERNAL"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 256
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        }
      },
      "ObjectID": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
      },
      "OperationContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environment",
          "purpose",
          "expires_at",
          "nonce"
        ],
        "properties": {
          "environment": {
            "enum": [
              "production",
              "staging",
              "development"
            ]
          },
          "purpose": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "nonce": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "subject": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "OperationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "operation_id",
          "object_id",
          "content_type",
          "result_base64"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_id": {
            "$ref": "#/components/schemas/ObjectID"
          },
          "content_type": {
            "type": "string",
            "maxLength": 128
          },
          "result_base64": {
            "type": "string",
            "maxLength": 1400000
          }
        }
      },
      "PublicKeyResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "object_id",
          "algorithm",
          "format",
          "public_key_base64",
          "fingerprint"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_id": {
            "$ref": "#/components/schemas/ObjectID"
          },
          "algorithm": {
            "type": "string",
            "maxLength": 64
          },
          "format": {
            "enum": [
              "spki-der",
              "openssh",
              "x509-der"
            ]
          },
          "public_key_base64": {
            "type": "string",
            "maxLength": 65536
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "ReleaseSecretRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "format",
          "payload_base64"
        ],
        "properties": {
          "context": {
            "$ref": "#/components/schemas/OperationContext"
          },
          "format": {
            "const": "regalia-envelope-v2"
          },
          "payload_base64": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "SealEnvelopeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "context",
          "format",
          "ciphertext_base64",
          "nonce_base64",
          "data_key_base64"
        ],
        "properties": {
          "object_id": {
            "$ref": "#/components/schemas/ObjectID"
          },
          "context": {
            "$ref": "#/components/schemas/OperationContext"
          },
          "format": {
            "type": "string",
            "const": "regalia-envelope-v2"
          },
          "ciphertext_base64": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 24,
            "maxLength": 1400000,
            "description": "AES-256-GCM ciphertext the caller produced locally; smallest is a tag over one byte."
          },
          "nonce_base64": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 16,
            "maxLength": 16,
            "description": "The 12-byte GCM nonce."
          },
          "data_key_base64": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 44,
            "maxLength": 44,
            "description": "The 32-byte data key; the only secret material on the wire, under mTLS."
          }
        }
      },
      "SecretResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "operation_id",
          "secret_id",
          "content_type",
          "value_base64"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "secret_id": {
            "$ref": "#/components/schemas/ObjectID"
          },
          "content_type": {
            "type": "string",
            "maxLength": 128
          },
          "value_base64": {
            "type": "string",
            "maxLength": 1400000
          }
        }
      },
      "SignRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "context",
          "content_type",
          "payload_base64"
        ],
        "properties": {
          "object_id": {
            "$ref": "#/components/schemas/ObjectID"
          },
          "context": {
            "$ref": "#/components/schemas/OperationContext"
          },
          "content_type": {
            "enum": [
              "application/vnd.cosmos.tx+protobuf",
              "application/vnd.regalia.release-manifest+json",
              "application/ssh-signature-input",
              "application/pkix-certification-request",
              "application/octet-stream"
            ]
          },
          "payload_base64": {
            "type": "string",
            "maxLength": 1400000,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        }
      },
      "UnwrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "context",
          "format",
          "wrapped_data_key_base64"
        ],
        "properties": {
          "object_id": {
            "$ref": "#/components/schemas/ObjectID"
          },
          "context": {
            "$ref": "#/components/schemas/OperationContext"
          },
          "format": {
            "enum": [
              "sops-pgp",
              "regalia-envelope-v2"
            ]
          },
          "wrapped_data_key_base64": {
            "type": "string",
            "maxLength": 65536,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "envelope_aad_base64": {
            "type": "string",
            "maxLength": 16384,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        }
      },
      "WrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
