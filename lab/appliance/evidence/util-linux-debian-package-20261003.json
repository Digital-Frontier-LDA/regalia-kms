      "text": "#!/bin/sh\nset -eu\nfor util_trial in first second; do\n    util_build_dir=/work/$util_trial\n    mkdir \"$util_build_dir\"\n    printf '%s\\n' 'fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec  /inputs/util-linux-2.42.4.tar.xz' '5b327ccd22f0f4ed28a389870aa51d04ecedb8693e52a1d122850f2b3188cbf6  /inputs/util-linux_2.41.5-0+deb13u1.debian.tar.xz' | sha256sum --check\n    tar -xJf /inputs/util-linux-2.42.4.tar.xz -C \"$util_build_dir\"\n    tar -xJf /inputs/util-linux_2.41.5-0+deb13u1.debian.tar.xz -C \"$util_build_dir/util-linux-2.42.4\"\n    sed \"s|/build/util-debian|$util_build_dir|g\" /inputs/prepare.py > \"$util_build_dir/prepare.py\"\n    python3 -I \"$util_build_dir/prepare.py\"\n    cd \"$util_build_dir/util-linux-2.42.4\"\n    echo \"starting $util_trial: uid=$(id -u) capabilities=$(grep '^CapEff:' /proc/self/status)\"\n    if env SOURCE_DATE_EPOCH=1790985600 DEB_BUILD_OPTIONS=parallel=4 dpkg-buildpackage -b -us -uc > \"$util_build_dir/build.log\" 2>&1; then\n        echo \"$util_trial Debian package build passed\"\n        tail -6 \"$util_build_dir/build.log\"\n    else\n        tail -100 \"$util_build_dir/build.log\"\n        exit 1\n    fi\n    cd /work\n    sha256sum \"$util_build_dir\"/*.deb > \"$util_build_dir/packages.sha256\"\ndone\n"
    },
    "prepare.py": {
      "sha256": "64917f00b9a4984be1555680729d92e04a34e79cc1fd5bbb116b5e37ff86d942",
      "text": "from pathlib import Path\nimport hashlib\nroot=Path('/build/util-debian/util-linux-2.42.4')\nfor name,digest in {'debian/control':'3f9ff1015a263906b45094949abb28bd8e8c0b5c2fd1176762de1553696fb305','debian/patches/upstream/loopdev-use-openat2-RESOLVE_NO_SYMLINKS-for-backing-file.patch':'9276c07a00380c76512cecdf1521489b403201ec0f15d63a831795365c46acf6','debian/patches/upstream/libmount-restrict-source-path-canonicalization-for-non-ro.patch':'543fe497aaa63410af1053e52724cb8bfae9d7e0660fd86c490b4ec43fde8133'}.items():assert hashlib.sha256((root/name).read_bytes()).hexdigest()==digest\np=root/'debian/patches/series';s=p.read_text()\nfor name in ['upstream/loopdev-use-openat2-RESOLVE_NO_SYMLINKS-for-backing-file.patch','upstream/libmount-restrict-source-path-canonicalization-for-non-ro.patch']:\n assert s.count(name+'\\n')==1;s=s.replace(name+'\\n','')\np.write_text(s)\np=root/'debian/control';s=p.read_text();original='Maintainer: Chris Hofstaedtler <zeha@debian.org>'\nassert s.count(original)==1;p.write_text(s.replace(original,'Maintainer: Regalia laboratory <noreply@example.invalid>'))\np=root/'debian/changelog';p.write_text('util-linux (2.42.4-0+regalia1) experimental; urgency=medium\\n\\n  * Laboratory build from authenticated upstream 2.42.4 with reviewed Debian packaging.\\n  * Upstreamed security patches are not applied twice; downstream Debian changes retained.\\n\\n -- Regalia laboratory <noreply@example.invalid>  Sat, 03 Oct 2026 00:00:00 +0000\\n\\n'+p.read_text())\n\np=root/'debian/patches/debian/lsfd-usrbin.patch';s=p.read_text();assert s.count('lsfd-cmd/file.c: errnos.h')==1;p.write_text(s.replace('lsfd-cmd/file.c: errnos.h','lsfd-cmd/error.c: errnos.h'))\n"
    }
