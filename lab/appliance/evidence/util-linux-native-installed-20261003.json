    "text": "FROM regalia-util-linux-debian-package-prototype:20261003\nUSER root\nCOPY *.deb packages.sha256 /inputs/\nCOPY code /inputs/code\nRUN sha256sum --check /inputs/packages.sha256 && rm -f /etc/dpkg/dpkg.cfg.d/docker /etc/dpkg/dpkg.cfg.d/docker-apt-speedup && apt-get install -y --no-install-recommends /inputs/*.deb && dpkg --audit && for binary in /usr/bin/mount /usr/bin/umount; do dpkg-statoverride --update --add root root 0755 \"$binary\"; done\nENTRYPOINT [\"python3\", \"-I\", \"/inputs/code/tools/lab_cli.py\", \"appliance-util-smoke\"]\n"
  },
